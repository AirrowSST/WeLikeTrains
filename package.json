{
  "name": "weliketrains",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "test:e2e:run": "node scripts/run-e2e.mjs --project=mobile-chromium --project=wide-screen-mobile-ui",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "verify:push": "npm run check && npm test",
    "verify:deploy:fast": "npm run build && npm test",
    "verify": "npm run build && npm test && npm run test:e2e:run",
    "check": "tsc --noEmit",
    "data:gtfs": "tsx scripts/import-gtfs.ts",
    "data:osm": "node scripts/import-osm.mjs",
    "evaluate": "tsx scripts/evaluate.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.2.0",
    "@google-cloud/text-to-speech": "^7.1.0",
    "@google/genai": "^2.23.0",
    "compression": "^1.8.2",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
