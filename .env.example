# Copy to .env. Never commit credentials.
PORT=8080
DATA_MODE=demo
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
# Allow local development to use Application Default Credentials for Vertex AI.
ENABLE_VERTEX_LOCAL=false
# Cloud Run uses its attached service account. Optional Vertex express-mode key:
VERTEX_API_KEY=
LTA_ACCOUNT_KEY=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# A token can be used instead; OneMap tokens expire after three days.
ONEMAP_TOKEN=
ENABLE_CLOUD_TTS=false
FIRESTORE_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com
SCHEDULER_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT=
PUBLIC_URL=http://localhost:5173
